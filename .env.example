# Example environment. Copy to .env and fill in real values.
#
# .env is git ignored and must never be committed. This file carries variable
# names and safe defaults only, never a real key.
#
# Will list, with placeholder values:
#
#   provider credentials
#     OPENAI_API_KEY               left blank here, supplied locally
#     ANTHROPIC_API_KEY            left blank here, supplied locally
#
#   state stores
#     SEMCACHE_REDIS_URL           redis://redis:6379/0
#     SEMCACHE_CHROMA_HOST         http://chromadb:8000
#
#   cache behaviour
#     SEMCACHE_SIMILARITY_THRESHOLD   0.90
#     SEMCACHE_CACHE_TTL_SECONDS      3600
#
#   admission control
#     SEMCACHE_BUCKET_CAPACITY        100000
#     SEMCACHE_BUCKET_REFILL_RATE     1000
#
#   providers
#     SEMCACHE_PRIMARY_PROVIDER       openai
#     SEMCACHE_SECONDARY_PROVIDER     anthropic
#
#   circuit breaker
#     SEMCACHE_BREAKER_FAILURE_THRESHOLD   5
#     SEMCACHE_BREAKER_WINDOW_SECONDS      60
#     SEMCACHE_BREAKER_BASE_BACKOFF        1.0
#     SEMCACHE_BREAKER_BACKOFF_CEILING     60.0
#
#   embedding
#     SEMCACHE_EMBEDDING_MODEL        all-MiniLM-L6-v2
#
#   observability
#     SEMCACHE_LOG_PROMPTS            false
